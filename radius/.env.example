# 시놀로지 FreeRADIUS 단독 실행 설정
TZ=Asia/Seoul

# privacyIDEA 서버 (인증서 SAN 의 이름과 같아야 함)
PI_HOSTNAME=pi.example.local
PI_SERVER_IP=192.168.0.10
PI_VALIDATE_URL=https://pi.example.local:8443/validate/check
PI_REALM=corp

# Palo Alto 방화벽의 RADIUS 요청 출발지 IP (공백 구분)
PALOALTO_IPS=192.168.0.1

# DSM 의 'RADIUS Server' 패키지가 1812 를 쓰고 있다면 패키지를 중지하거나 포트 변경
RADIUS_AUTH_PORT=1812
RADIUS_BIND=0.0.0.0

# BlastRADIUS(CVE-2024-3596) 대응: auto | yes | no
RADIUS_REQUIRE_MESSAGE_AUTHENTICATOR=auto
# 사용자 실제 접속 IP 를 privacyIDEA 로 전달 (비우면 NAS-IP 사용)
PI_CLIENT_ATTRIBUTE=PaloAlto-Client-Source-IP
PI_GROUP_ATTRIBUTE=
# 그룹 값에서 이름을 뽑는 정규식 (기본: AD DN 의 CN, 예 CN=VPN-Users,OU=... → VPN-Users)
PI_GROUP_REGEX=
